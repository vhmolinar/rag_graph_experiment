# Exemplo de configuração — copie para .env e preencha. Nunca commitar .env real.

# Banco de dados (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragbooks
POSTGRES_USER=ragbooks
POSTGRES_PASSWORD=trocar-no-seu-env

# Endpoints de modelos (compatíveis com OpenAI para embedding/geração; HTTP explícito para reranking)
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_API_KEY=trocar-no-seu-env
RERANKER_BASE_URL=http://localhost:8002
RERANKER_MODEL=qwen3-reranker
RERANKER_API_KEY=trocar-no-seu-env
GENERATOR_BASE_URL=http://localhost:8003/v1
GENERATOR_MODEL=qwen3-instruct
GENERATOR_API_KEY=trocar-no-seu-env

# Armazenamento de artefatos (volume local por hash SHA-256)
ARTIFACT_ROOT=./artifacts

# API
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# Observabilidade (vazio = traces desabilitados localmente)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Retenção de telemetria anonimizada (dias)
RETENTION_DAYS=90
